{
  "name": "lntu-schedule-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-webapp-assets.mjs",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.8",
    "dotenv": "^17.2.2",
    "luxon": "^3.7.2",
    "mongodb": "^6.21.0",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.4",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.1",
    "@types/opentype.js": "^1.3.8",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
